# ─── Jira Configuration ───────────────────────────────────────
# Your Jira Cloud instance URL
JIRA_BASE_URL=https://your-org.atlassian.net

# The email you use to log in to Jira
JIRA_EMAIL=your.email@company.com

# Generate from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# Jira project key to scan (e.g. DEV, PROJ, UI)
JIRA_PROJECT=DEV

# ─── Team Members ─────────────────────────────────────────────
# Comma-separated Jira accountIds of team members to track for @mentions
# Find accountId: GET /rest/api/3/user/search?query=Name (Basic Auth)
TEAM_ACCOUNT_IDS=accountId1,accountId2,accountId3

# ─── Optional: Microsoft Teams Integration (Phase 2) ──────────
TEAMS_WEBHOOK_URL=
